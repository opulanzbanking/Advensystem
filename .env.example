# Contact form e-mail notification (see README for details).
# advensystem.lu mail is hosted by OVH: use the contact@advensystem.lu mailbox.
# Without these values leads are still stored, but no e-mail is sent.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@advensystem.lu
SMTP_PASS=
SMTP_FROM=AdvenSystem.lu <contact@advensystem.lu>
CONTACT_TO=contact@advensystem.lu

# Lead storage in git. Must be a PRIVATE repository, never this public one.
# Token: fine-grained PAT limited to that repo, permission "Contents: read and write".
LEADS_GITHUB_TOKEN=
LEADS_GITHUB_REPO=opulanzbanking/advensystem-leads
LEADS_GITHUB_BRANCH=main
LEADS_GITHUB_PATH=leads.csv

# Required to read /api/leads?key=...&format=csv (endpoint is closed without it).
LEADS_SECRET=
